// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id                  Int                    @id @default(autoincrement())
  name                String
  email               String                 @unique
  password            String
  totpSecret          String?
  totpEnabled         Boolean                @default(false)
  school              String?
  year                Int?
  country             String?
  level               SchoolLevel?
  subjects            Subject[]
  passwordResetTokens PasswordResetToken[]
  resetChallenges     PasswordResetChallenge[]

  @@map("Student")
}

enum SchoolLevel {
  Primary
  Middle
  Higher
}

model Subject {
  id        Int     @id @default(autoincrement())
  title     String
  student   Student @relation(fields: [studentId], references: [id])
  studentId Int
  topics    Topic[]

  @@map("Subject")
}

model Topic {
  id         Int         @id @default(autoincrement())
  title      String
  subject    Subject     @relation(fields: [subjectId], references: [id])
  subjectId  Int
  flashcards Flashcard[]

  @@map("Topic")
}

model Flashcard {
  id      Int    @id @default(autoincrement())
  value   String
  topic   Topic  @relation(fields: [topicId], references: [id])
  topicId Int

  @@map("Flashcard")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  studentId Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  student   Student   @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@map("PasswordResetToken")
}

model PasswordResetChallenge {
  id            Int       @id @default(autoincrement())
  studentId     Int
  challengeHash String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  student       Student   @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@map("PasswordResetChallenge")
}
